{
  "openapi": "3.1.0",
  "info": {
    "title": "Graft Harness Run API",
    "version": "v1",
    "description": "Transport-neutral contract for harness-owned Run capabilities. Production identity is resolved by the Authority Service from the raw surface credential. The retained WSGI provider accepts the same canonical inputs and receives a test-only verified identity out of band; it does not prove production identity verification. No customer-system Tool operation is part of this contract.",
    "x-graft-contract-status": "authoritative",
    "x-graft-implementation-status": {
      "rest-create-retrieve-cancel-replay": "reference-provider-supported",
      "authority-service-identity-resolution": "implementation-pending",
      "streamable-http-mcp-adapter": "implementation-pending-gate-2"
    }
  },
  "servers": [
    {
      "url": "https://harness.invalid",
      "description": "Deployment supplied by the consuming team"
    }
  ],
  "security": [
    {
      "GraftSurfaceCredential": []
    }
  ],
  "paths": {
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "Create a private read-only Run",
        "description": "The Authority Service resolves graft_principal_id and graft_tenant_id from the authenticated surface credential. A repeated idempotency key returns the original Run; a changed request under that key is a conflict.",
        "x-graft-provider-status": "reference-provider-supported",
        "x-graft-provider-supported-errors": [
          "invalid_request",
          "unsupported_contract_version",
          "idempotency_conflict"
        ],
        "x-graft-declared-error-codes": [
          "authentication_required",
          "authentication_failed",
          "authorisation_denied",
          "invalid_request",
          "unsupported_contract_version",
          "idempotency_conflict",
          "throttled",
          "request_timeout",
          "service_unavailable",
          "internal_error"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreateRequest"
              },
              "examples": {
                "alert": {
                  "$ref": "#/components/examples/CreateRunRequest"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run created",
            "headers": {
              "X-Graft-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                },
                "examples": {
                  "created": {
                    "$ref": "#/components/examples/Run"
                  }
                }
              }
            }
          },
          "200": {
            "description": "Existing idempotent Run returned",
            "headers": {
              "X-Graft-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                },
                "examples": {
                  "replayed": {
                    "$ref": "#/components/examples/Run"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AuthorisationDenied"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    },
    "/v1/runs/{graft_run_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "getRun",
        "summary": "Retrieve a Run",
        "x-graft-provider-status": "reference-provider-supported",
        "x-graft-provider-supported-errors": [
          "not_found"
        ],
        "x-graft-declared-error-codes": [
          "authentication_required",
          "authentication_failed",
          "authorisation_denied",
          "not_found",
          "throttled",
          "request_timeout",
          "service_unavailable",
          "internal_error"
        ],
        "responses": {
          "200": {
            "description": "Run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                },
                "examples": {
                  "run": {
                    "$ref": "#/components/examples/Run"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AuthorisationDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    },
    "/v1/runs/{graft_run_id}/events": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "replayRunEvents",
        "summary": "Replay or follow ordered Run events",
        "description": "after_graft_event_id is an exclusive cursor. A JSON response is a bounded replay page. text/event-stream follows the same replay with a live tail; reconnect starts after the last received graft_event_id. The cursor is never reused inclusively and a missing/expired cursor fails closed.",
        "x-graft-provider-status": "reference-provider-supported-json-replay; live-stream-pending",
        "x-graft-provider-supported-errors": [
          "invalid_request",
          "cursor_invalid",
          "not_found"
        ],
        "x-graft-declared-error-codes": [
          "authentication_required",
          "authentication_failed",
          "authorisation_denied",
          "invalid_request",
          "not_found",
          "state_conflict",
          "cursor_invalid",
          "replay_cursor_expired",
          "throttled",
          "request_timeout",
          "service_unavailable",
          "internal_error",
          "unsupported_contract_version"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AfterEventId"
          },
          {
            "$ref": "#/components/parameters/EventLimit"
          },
          {
            "$ref": "#/components/parameters/ReplayMode"
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered replay page or live event stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReplayPage"
                },
                "examples": {
                  "replay": {
                    "$ref": "#/components/examples/EventReplayPage"
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "stream": {
                    "value": "id: 42\nevent: token\ndata: {\"graft_event_id\":42}\n\n"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/CursorInvalid"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AuthorisationDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/ReplayCursorExpired"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    },
    "/v1/runs/{graft_run_id}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "cancelRun",
        "summary": "Request Run cancellation",
        "description": "Cancellation is accepted at the next step boundary. Repeated requests are idempotent; a terminal Run returns an already_terminal outcome.",
        "x-graft-provider-status": "reference-provider-supported",
        "x-graft-provider-supported-errors": [
          "invalid_request",
          "unsupported_contract_version",
          "not_found"
        ],
        "x-graft-declared-error-codes": [
          "authentication_required",
          "authentication_failed",
          "authorisation_denied",
          "invalid_request",
          "unsupported_contract_version",
          "not_found",
          "state_conflict",
          "throttled",
          "request_timeout",
          "service_unavailable",
          "internal_error"
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "examples": {
                "cancel": {
                  "$ref": "#/components/examples/CancelRequest"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cancellation accepted or already terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOutcome"
                },
                "examples": {
                  "accepted": {
                    "$ref": "#/components/examples/CancelOutcome"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AuthorisationDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/RequestTimeout"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "GraftSurfaceCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "surface-credential",
        "description": "Raw surface credential forwarded verbatim to the future Authority Service over mTLS. The reference WSGI provider uses a deterministic test identity seam instead; it does not prove production identity verification."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Harness request correlation identifier",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters": {
      "RunId": {
        "name": "graft_run_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "IdempotencyKey": {
        "name": "X-Graft-Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "IdempotencyKeyOptional": {
        "name": "X-Graft-Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "AfterEventId": {
        "name": "after_graft_event_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "EventLimit": {
        "name": "graft_event_limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "ReplayMode": {
        "name": "graft_replay_mode",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "replay",
            "follow"
          ],
          "default": "replay"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Request validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/InvalidRequest"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "invalid_request",
          "unsupported_contract_version"
        ]
      },
      "AuthenticationRequired": {
        "description": "No usable credential",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/AuthenticationRequired"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "authentication_required",
          "authentication_failed"
        ]
      },
      "AuthorisationDenied": {
        "description": "Credential is valid but not authorised",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/AuthorisationDenied"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "authorisation_denied"
        ]
      },
      "NotFound": {
        "description": "Run or cursor was not visible",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/NotFound"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "not_found"
        ]
      },
      "IdempotencyConflict": {
        "description": "Idempotency key was reused for different input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/IdempotencyConflict"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "idempotency_conflict"
        ]
      },
      "StateConflict": {
        "description": "Operation conflicts with current Run state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/StateConflict"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "state_conflict"
        ]
      },
      "CursorInvalid": {
        "description": "Cursor is malformed or outside the Run stream",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/CursorInvalid"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "cursor_invalid",
          "invalid_request",
          "unsupported_contract_version"
        ]
      },
      "ReplayCursorExpired": {
        "description": "Cursor is older than the retained replay window",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/ReplayCursorExpired"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "replay_cursor_expired"
        ]
      },
      "Throttled": {
        "description": "Rate or connection limit exceeded",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/Throttled"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "throttled"
        ]
      },
      "InternalError": {
        "description": "Unexpected harness failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/InternalError"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "internal_error"
        ]
      },
      "RequestTimeout": {
        "description": "Request exceeded its deadline",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/RequestTimeout"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "request_timeout"
        ]
      },
      "ServiceUnavailable": {
        "description": "Required dependency unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            },
            "examples": {
              "error": {
                "$ref": "#/components/examples/ServiceUnavailable"
              }
            }
          }
        },
        "x-graft-error-codes": [
          "service_unavailable"
        ]
      }
    },
    "schemas": {
      "AlertTrigger": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "graft_source",
          "graft_alert_id",
          "graft_summary",
          "graft_fingerprint"
        ],
        "properties": {
          "graft_source": {
            "type": "string",
            "minLength": 1
          },
          "graft_alert_id": {
            "type": "string",
            "minLength": 1
          },
          "graft_summary": {
            "type": "string",
            "maxLength": 4096
          },
          "graft_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "graft_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RunCreateRequest": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "graft_trigger"
        ],
        "properties": {
          "graft_trigger": {
            "$ref": "#/components/schemas/AlertTrigger"
          },
          "graft_trigger_kind": {
            "const": "system_initiated"
          },
          "graft_visibility": {
            "const": "private"
          },
          "graft_tool_classes": {
            "type": "array",
            "const": [
              "read"
            ]
          },
          "graft_contract_version": {
            "const": "v1"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "graft_tenant_id"
              ]
            },
            {
              "required": [
                "graft_principal_id"
              ]
            },
            {
              "required": [
                "graft_identity"
              ]
            }
          ]
        },
        "description": "No identity fields are accepted. Identity is resolved from the authenticated credential; the reference provider receives a test-only verified identity out of band."
      },
      "Run": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "graft_run_id",
          "graft_tenant_id",
          "graft_principal_id",
          "graft_status",
          "graft_tool_classes",
          "graft_contract_version"
        ],
        "properties": {
          "graft_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "graft_tenant_id": {
            "type": "string"
          },
          "graft_principal_id": {
            "type": "string"
          },
          "graft_status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "cancelled",
              "failed",
              "cancellation_requested"
            ]
          },
          "graft_terminal_outcome": {
            "enum": [
              "finding",
              "no_finding",
              "cancelled",
              "failed",
              "timed_out",
              null
            ]
          },
          "graft_finding_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExternalReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "graft_tool_classes": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "destructive"
              ]
            }
          },
          "graft_created_at": {
            "type": "string",
            "format": "date-time"
          },
          "graft_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "graft_contract_version": {
            "const": "v1"
          },
          "graft_identity_source": {
            "const": "authority_service"
          }
        }
      },
      "ExternalReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graft_ref_kind",
          "graft_uri"
        ],
        "properties": {
          "graft_ref_kind": {
            "type": "string",
            "minLength": 1
          },
          "graft_uri": {
            "type": "string",
            "pattern": "^(graft://|https://)"
          },
          "graft_sha256": {
            "type": "string"
          },
          "graft_content_type": {
            "type": "string"
          },
          "graft_byte_length": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RunEvent": {
        "$ref": "https://graft.example/contracts/run-events-v1.schema.json"
      },
      "EventReplayPage": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "graft_run_id",
          "graft_events",
          "graft_next_after_event_id",
          "graft_has_more",
          "graft_contract_version"
        ],
        "properties": {
          "graft_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "graft_events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            }
          },
          "graft_next_after_event_id": {
            "type": "integer",
            "minimum": 0
          },
          "graft_has_more": {
            "type": "boolean"
          },
          "graft_contract_version": {
            "const": "v1"
          }
        }
      },
      "CancelRequest": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "graft_reason": {
            "type": "string",
            "maxLength": 1024
          },
          "graft_contract_version": {
            "const": "v1"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "graft_tenant_id"
              ]
            },
            {
