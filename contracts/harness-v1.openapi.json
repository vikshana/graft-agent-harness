{
  "openapi": "3.1.0",
  "info": {"title": "Graft Harness Contract", "version": "v1"},
  "paths": {
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunCreateRequest"}}}},
        "responses": {"201": {"description": "Run created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}}, "200": {"description": "Existing idempotent Run"}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/runs/{graft_run_id}": {
      "parameters": [{"$ref": "#/components/parameters/RunId"}],
      "get": {"operationId": "getRun", "responses": {"200": {"description": "Run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/runs/{graft_run_id}/events": {
      "get": {"operationId": "replayEvents", "parameters": [{"$ref": "#/components/parameters/RunId"}, {"name": "after_graft_event_id", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}], "responses": {"200": {"description": "Ordered event replay", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RunEvent"}}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/runs/{graft_run_id}/cancel": {
      "post": {"operationId": "cancelRun", "parameters": [{"$ref": "#/components/parameters/RunId"}], "responses": {"202": {"description": "Cancellation accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CancelOutcome"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "parameters": {
      "RunId": {"name": "graft_run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "X-Graft-Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1}}
    },
    "responses": {"Error": {"description": "Standard error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {
      "AlertTrigger": {"type": "object", "required": ["source", "alert_id", "summary", "fingerprint"], "properties": {"source": {"type": "string"}, "alert_id": {"type": "string"}, "summary": {"type": "string"}, "fingerprint": {"type": "string"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "RunCreateRequest": {"type": "object", "required": ["graft_tenant_id", "graft_principal_id", "trigger", "idempotency_key"], "properties": {"graft_tenant_id": {"type": "string", "format": "uuid"}, "graft_principal_id": {"type": "string"}, "idempotency_key": {"type": "string"}, "trigger": {"$ref": "#/components/schemas/AlertTrigger"}, "trigger_kind": {"const": "system_initiated"}, "visibility": {"const": "private"}, "tool_classes": {"type": "array", "items": {"const": "read"}}}},
      "Run": {"type": "object", "required": ["graft_run_id", "graft_tenant_id", "status", "tool_classes", "contract_version"], "properties": {"graft_run_id": {"type": "string"}, "graft_tenant_id": {"type": "string"}, "graft_principal_id": {"type": "string"}, "status": {"enum": ["queued", "running", "completed", "cancelled", "failed", "cancellation_requested"]}, "terminal_outcome": {"type": ["string", "null"]}, "finding": {"type": ["string", "null"]}, "tool_classes": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "contract_version": {"const": "v1"}}},
      "RunEvent": {"type": "object", "required": ["graft_event_id", "graft_run_id", "graft_tenant_id", "event_type", "event_version", "payload"], "properties": {"graft_event_id": {"type": "integer"}, "graft_run_id": {"type": "string"}, "graft_tenant_id": {"type": "string"}, "event_type": {"type": "string"}, "event_version": {"const": 1}, "payload": {"type": "object"}, "created_at": {"type": "string", "format": "date-time"}, "contract_version": {"const": "v1"}}},
      "CancelOutcome": {"type": "object", "required": ["graft_run_id", "outcome", "status", "contract_version"], "properties": {"graft_run_id": {"type": "string"}, "outcome": {"type": "string"}, "status": {"type": "string"}, "contract_version": {"const": "v1"}}},
      "ErrorEnvelope": {"type": "object", "required": ["code", "message", "request_id", "contract_version"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "details": {"type": "object"}, "contract_version": {"const": "v1"}}}
    }
  }
}
