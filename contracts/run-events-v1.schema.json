{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graft.example/contracts/run-events-v1.schema.json",
  "title": "Graft Run Event v1",
  "description": "Ordered Tenant-scoped Run events. Additive fields and event types are tolerated by consumers. Payloads contain summaries and external pointers, never raw large Tool results.",
  "type": "object",
  "additionalProperties": true,
  "required": ["graft_event_id", "graft_run_id", "graft_tenant_id", "graft_event_type", "graft_event_version", "graft_payload", "graft_created_at", "graft_contract_version"],
  "properties": {
    "graft_event_id": {"type": "integer", "minimum": 1},
    "graft_run_id": {"type": "string", "minLength": 1},
    "graft_tenant_id": {"type": "string", "minLength": 1},
    "graft_event_type": {"type": "string", "minLength": 1, "x-known-values": ["status", "token", "agent_thought", "plan_updated", "tool_call_start", "tool_call_result", "evidence_added", "hypothesis_updated", "confidence_changed", "action_proposed", "action_confirmed", "action_executed", "sub_agent_spawned", "hitl_required", "budget_consumed", "budget_warning", "error", "done"]},
    "graft_event_version": {"const": 1},
    "event_version": {"const": 1, "deprecated": true, "description": "Legacy prototype alias; canonical wire fields are graft-prefixed."},
    "graft_payload": {"$ref": "#/$defs/EventPayload"},
    "graft_created_at": {"type": "string", "format": "date-time"},
    "graft_contract_version": {"const": "v1"}
  },
  "allOf": [
    {"if": {"properties": {"graft_event_type": {"const": "status"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/StatusPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "token"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/TextPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "agent_thought"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/TextPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "plan_updated"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "tool_call_start"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/ToolCallStartPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "tool_call_result"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/ToolCallResultPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "evidence_added"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/EvidencePayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "hypothesis_updated"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "confidence_changed"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/ConfidencePayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "action_proposed"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "action_confirmed"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "action_executed"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "sub_agent_spawned"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/ChildRunPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "hitl_required"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/PointerPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "budget_consumed"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/BudgetPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "budget_warning"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/BudgetPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "error"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/ErrorPayload"}}}},
    {"if": {"properties": {"graft_event_type": {"const": "done"}}}, "then": {"properties": {"graft_payload": {"$ref": "#/$defs/DonePayload"}}}}
  ],
  "$defs": {
    "ExternalReference": {"type": "object", "additionalProperties": false, "required": ["graft_ref_kind", "graft_uri"], "properties": {"graft_ref_kind": {"type": "string", "minLength": 1}, "graft_uri": {"type": "string", "pattern": "^(graft://|https://)"}, "graft_sha256": {"type": "string"}, "graft_content_type": {"type": "string"}, "graft_byte_length": {"type": "integer", "minimum": 0}}},
    "EventPayload": {"type": "object", "additionalProperties": true},
    "StatusPayload": {"type": "object", "additionalProperties": true, "required": ["graft_status"], "properties": {"graft_status": {"enum": ["queued", "running", "completed", "cancelled", "failed", "cancellation_requested"]}}},
    "TextPayload": {"type": "object", "additionalProperties": true, "required": ["graft_text"], "properties": {"graft_text": {"type": "string"}}},
    "PointerMetadata": {"type": "object", "additionalProperties": false, "description": "The only reviewed v1 extension point for pointer metadata; it carries labels, never content.", "properties": {"graft_label": {"type": "string", "maxLength": 256}, "graft_origin": {"type": "string", "maxLength": 256}}},
    "PointerPayload": {"type": "object", "additionalProperties": false, "required": ["graft_ref"], "properties": {"graft_ref": {"$ref": "#/$defs/ExternalReference"}, "graft_pointer_metadata": {"$ref": "#/$defs/PointerMetadata"}}},
    "ToolCallStartPayload": {"type": "object", "additionalProperties": true, "required": ["graft_tool_call_id", "graft_tool_name", "graft_arguments_sha256"], "properties": {"graft_tool_call_id": {"type": "string"}, "graft_tool_name": {"type": "string"}, "graft_arguments_sha256": {"type": "string"}}},
    "ToolCallResultPayload": {"type": "object", "additionalProperties": false, "required": ["graft_tool_call_id", "graft_artifact_ref"], "properties": {"graft_tool_call_id": {"type": "string"}, "graft_artifact_ref": {"$ref": "#/$defs/ExternalReference"}, "graft_pointer_metadata": {"$ref": "#/$defs/PointerMetadata"}}},
    "EvidencePayload": {"type": "object", "additionalProperties": false, "required": ["graft_evidence_id"], "properties": {"graft_evidence_id": {"type": "string"}, "graft_external_ref": {"$ref": "#/$defs/ExternalReference"}, "graft_pointer_metadata": {"$ref": "#/$defs/PointerMetadata"}}},
    "ConfidencePayload": {"type": "object", "additionalProperties": true, "required": ["graft_confidence"], "properties": {"graft_confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "ChildRunPayload": {"type": "object", "additionalProperties": true, "required": ["graft_child_run_id"], "properties": {"graft_child_run_id": {"type": "string"}}},
    "BudgetPayload": {"type": "object", "additionalProperties": true, "required": ["graft_budget_kind", "graft_consumed", "graft_limit"], "properties": {"graft_budget_kind": {"type": "string"}, "graft_consumed": {"type": "number", "minimum": 0}, "graft_limit": {"type": "number", "minimum": 0}}},
    "ErrorPayload": {"type": "object", "additionalProperties": true, "required": ["graft_code", "graft_message"], "properties": {"graft_code": {"enum": ["authentication_required", "authentication_failed", "authorisation_denied", "invalid_request", "unsupported_contract_version", "not_found", "idempotency_conflict", "state_conflict", "cursor_invalid", "replay_cursor_expired", "throttled", "request_timeout", "service_unavailable", "internal_error"]}, "graft_message": {"type": "string"}}},
    "DonePayload": {"type": "object", "additionalProperties": true, "required": ["graft_outcome"], "properties": {"graft_outcome": {"enum": ["finding", "no_finding", "cancelled", "failed", "timed_out"]}}}
  },
  "examples": [
    {"graft_event_id": 1, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "status", "graft_event_version": 1, "graft_payload": {"graft_status": "queued"}, "graft_created_at": "2026-09-20T10:00:00Z", "graft_contract_version": "v1"},
    {"graft_event_id": 2, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "token", "graft_event_version": 1, "graft_payload": {"graft_text": "Investigation "}, "graft_created_at": "2026-09-20T10:00:01Z", "graft_contract_version": "v1"},
    {"graft_event_id": 3, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "agent_thought", "graft_event_version": 1, "graft_payload": {"graft_text": "Checking evidence"}, "graft_created_at": "2026-09-20T10:00:01Z", "graft_contract_version": "v1"},
    {"graft_event_id": 4, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "plan_updated", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "plan", "graft_uri": "graft://artifacts/plan-01"}}, "graft_created_at": "2026-09-20T10:00:01Z", "graft_contract_version": "v1"},
    {"graft_event_id": 5, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "tool_call_start", "graft_event_version": 1, "graft_payload": {"graft_tool_call_id": "tool-call-01", "graft_tool_name": "get_alert", "graft_arguments_sha256": "sha256"}, "graft_created_at": "2026-09-20T10:00:02Z", "graft_contract_version": "v1"},
    {"graft_event_id": 6, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "tool_call_result", "graft_event_version": 1, "graft_payload": {"graft_tool_call_id": "tool-call-01", "graft_artifact_ref": {"graft_ref_kind": "tool-result", "graft_uri": "graft://artifacts/result-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 7, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "evidence_added", "graft_event_version": 1, "graft_payload": {"graft_evidence_id": "evidence-01", "graft_external_ref": {"graft_ref_kind": "log", "graft_uri": "graft://artifacts/log-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 8, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "hypothesis_updated", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "hypothesis", "graft_uri": "graft://artifacts/hypothesis-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 9, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "confidence_changed", "graft_event_version": 1, "graft_payload": {"graft_confidence": 0.75}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 10, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "action_proposed", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "action", "graft_uri": "graft://artifacts/action-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 11, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "action_confirmed", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "action", "graft_uri": "graft://artifacts/action-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 12, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "action_executed", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "action-result", "graft_uri": "graft://artifacts/action-result-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 13, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "sub_agent_spawned", "graft_event_version": 1, "graft_payload": {"graft_child_run_id": "run-child-01"}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 14, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "hitl_required", "graft_event_version": 1, "graft_payload": {"graft_ref": {"graft_ref_kind": "approval", "graft_uri": "graft://artifacts/approval-01"}}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 15, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "budget_consumed", "graft_event_version": 1, "graft_payload": {"graft_budget_kind": "tokens", "graft_consumed": 10, "graft_limit": 100}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 16, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "budget_warning", "graft_event_version": 1, "graft_payload": {"graft_budget_kind": "tokens", "graft_consumed": 90, "graft_limit": 100}, "graft_created_at": "2026-09-20T10:00:03Z", "graft_contract_version": "v1"},
    {"graft_event_id": 17, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "error", "graft_event_version": 1, "graft_payload": {"graft_code": "service_unavailable", "graft_message": "dependency unavailable"}, "graft_created_at": "2026-09-20T10:00:04Z", "graft_contract_version": "v1"},
    {"graft_event_id": 18, "graft_run_id": "run-01", "graft_tenant_id": "tenant-01", "graft_event_type": "done", "graft_event_version": 1, "graft_payload": {"graft_outcome": "finding"}, "graft_created_at": "2026-09-20T10:00:05Z", "graft_contract_version": "v1"}
  ],
  "x-graft-versioning": {
    "additive": "The global event envelope, unknown event types, and additive fields on non-sensitive payloads are tolerant. A pointer/reference payload is closed in v1: only the reviewed graft_pointer_metadata extension point may carry safe metadata, never inline content.",
    "breaking": "Changing event_version, removing/renaming required fields, adding an inline field to a closed pointer/reference payload, changing payload meaning or type, or reusing an event_type for another meaning requires a new major contract version or an explicitly reviewed schema extension.",
    "cursor": "graft_event_id is monotonically increasing per event log; after_graft_event_id is exclusive."
  }
}
